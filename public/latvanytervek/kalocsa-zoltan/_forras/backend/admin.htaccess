# Kalocsa GeoWorks – statisztika (csak Zoltánnak)
Options -Indexes
DirectoryIndex statisztika.php

# Csak a statisztika.php érhető el, minden más tiltva.
<FilesMatch ".*">
  Require all denied
</FilesMatch>
<Files "statisztika.php">
  Require all granted
  # Opcionális, erősebb védelem: csak megadott IP-címről (a fenti sor helyett):
  # Require ip 1.2.3.4
</Files>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set Cache-Control "no-store"
</IfModule>
