# Kalocsa GeoWorks – éles oldal (kalocsageoworks.com, MHosting)
# Az nginx előtét az X-Forwarded-Proto fejlécben adja át a protokollt.
# A /.well-known kimarad, hogy a tanúsítvány-megújítás működjön.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0) Adatküldő kérés (POST, PUT, …) csak a bekapcsolt végpontokra mehet, minden másra 405.
  #    Ajánlatkérő nélkül (alapállapot) sehova; a build --ajanlat módban az /api/ajanlat.php kivételt maga teszi be.
  RewriteCond %{REQUEST_METHOD} !^(GET|HEAD)$
{{POST_EXCEPT}}  RewriteRule ^ - [R=405,L]

  # 1) Egyetlen hivatalos cím: https, www nélkül
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
  RewriteRule ^ https://kalocsageoworks.com%{REQUEST_URI} [R=301,L]

  # 2) /index.html -> /
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
  RewriteRule ^index\.html$ https://kalocsageoworks.com/ [R=301,L]
</IfModule>

DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes

# rejtett és fejlesztői fájlok tiltása (a /.well-known kivételével)
<FilesMatch "^\.(?!well-known)|\.(md|py|sh|bak|old|orig|log|ini|env|sql|zip|tar|gz)$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # indexelés tiltva a jogi/működési ellenőrzésig (élesítéskor ezt a sort törölni kell)
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'sha256-{{INLINE_SHA}}'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; media-src 'self' blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action {{FORM_ACTION}}; frame-ancestors 'self'; upgrade-insecure-requests"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/plain application/ld+json
</IfModule>

<IfModule mod_mime.c>
  AddType font/woff .woff
  AddType image/webp .webp
  AddType image/svg+xml .svg
  AddType video/mp4 .mp4
</IfModule>
